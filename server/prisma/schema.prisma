generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FoodItemType {
  /**
   * For example carrot, rice, falafel.
   */
  NORMAL
  /**
   * For example lactose, gluten.
   */
  CATEGORY
}

model FoodItem {
  id            Int          @id @default(autoincrement())
  type          FoodItemType
  svName        String
  enName        String?
  svDescription String?
  enDescription String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  relationsAsParent FoodItemRelation[] @relation("Parent")
  relationsAsChild  FoodItemRelation[] @relation("Child")
  restrictions      Restriction[]
}

enum FoodItemRelationType {
  /**
   * For example, a sandwich contains bread and ham.
   */
  CONTAINS
  /**
   * For example, chickpeas are a type of legume.
   */
  IS_A
}

model FoodItemRelation {
  id           Int                  @id @default(autoincrement())
  fromId       Int
  toId         Int
  relationType FoodItemRelationType
  optional     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  parent FoodItem @relation("Parent", fields: [fromId], references: [id])
  child  FoodItem @relation("Child", fields: [toId], references: [id])
}

/**
 * A person whose diet we keep track of.
 */
model Person {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restrictions Restriction[]
}

/**
 * Something that stops a person from eating certain food items, for example a
 * lactose intolerance, a legume allergy or being a vegetarian.
 *
 * The food items are the ones that may not be eaten. A food item is also off
 * limits when one of its children, or their children, is restricted.
 */
model Restriction {
  id            Int      @id @default(autoincrement())
  svName        String
  enName        String?
  svDescription String?
  enDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  people    Person[]
  foodItems FoodItem[]
}
