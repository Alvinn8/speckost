generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FoodItemType {
  /**
   * For example carrot, rice, falafel.
   */
  NORMAL
  /**
   * For example lactose, gluten.
   */
  CATEGORY
  /**
   * For example tacos.
   */
  DISH
}

model FoodItem {
  id            Int          @id @default(autoincrement())
  type          FoodItemType
  svName        String
  enName        String?
  svDescription String?
  enDescription String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  relationsAsParent            FoodItemRelation[]            @relation("Parent")
  relationsAsChild             FoodItemRelation[]            @relation("Child")
  restrictions                 Restriction[]
  foodItemRelationAlternatives FoodItemRelationAlternative[]
}

enum FoodItemRelationType {
  /**
   * For example, a sandwich contains bread and ham.
   */
  CONTAINS
  /**
   * For example, chickpeas are a type of legume.
   */
  IS_A
}

model FoodItemRelation {
  id           Int                  @id @default(autoincrement())
  fromId       Int
  toId         Int
  relationType FoodItemRelationType
  optional     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  parent       FoodItem                      @relation("Parent", fields: [fromId], references: [id])
  child        FoodItem                      @relation("Child", fields: [toId], references: [id])
  alternatives FoodItemRelationAlternative[]
}

/**
 * An alternative food item for a relation. For example, if a sandwich
 * contains cheese, an alternative could be vegan cheese.
 */
model FoodItemRelationAlternative {
  id                    Int      @id @default(autoincrement())
  relationId            Int
  replacementFoodItemId Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  relation            FoodItemRelation @relation(fields: [relationId], references: [id])
  replacementFoodItem FoodItem         @relation(fields: [replacementFoodItemId], references: [id])
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restrictions PersonRestriction[]
  groups       PersonGroup[]
}

model Restriction {
  id            Int      @id @default(autoincrement())
  svName        String
  enName        String?
  svDescription String?
  enDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /**
   * The food items that cannot be eaten.
   */
  foodItems          FoodItem[]
  personRestrictions PersonRestriction[]
}

model PersonRestriction {
  id            Int      @id @default(autoincrement())
  personId      Int
  restrictionId Int
  airborne      Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person      Person      @relation(fields: [personId], references: [id])
  restriction Restriction @relation(fields: [restrictionId], references: [id])
}

model PersonGroup {
  id        Int      @id @default(autoincrement())
  svName    String
  enName    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people Person[]

  subGroups    PersonGroup[] @relation("SubGroups")
  parentGroups PersonGroup[] @relation("SubGroups")
}
